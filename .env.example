# Copy to .env.local and fill in. None of these are committed (.env* is gitignored).

# Public base URL of your deployment (used by the manifest + embeds).
# Local dev can leave this unset (falls back to http://localhost:3000).
NEXT_PUBLIC_URL=https://your-app.vercel.app

# OnchainKit / Coinbase Developer Platform API key — https://portal.cdp.coinbase.com
# Used for wallet connection + RPC. Recommended (the app falls back to public RPCs).
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Neynar API key — https://neynar.com — powers the gift-a-ticket recipient lookup
# (@username -> verified Base address). Only the FREE by_username/bulk endpoints
# are used. Without it, gift-by-handle search is disabled; self-buy still works.
NEYNAR_API_KEY=

# --- Optional: post-draw "check your results" notifications ---
# Upstash Redis (REST) stores Farcaster notification tokens. If unset, the
# notification + webhook routes no-op cleanly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# to authorize the cron job. FAIL-CLOSED: if this is unset the route rejects every
# request, so the cron simply never runs — it does not become world-callable.
CRON_SECRET=

# --- Optional: group-buy pool cranking (see contracts/src/FarpotPool.sol) ---
# Private key of a DEDICATED keeper wallet that calls FarpotPool.claimBatch() from
# the cron, pulling a settled pool's winnings in so contributors can claim them.
#
# Make this a FRESH wallet holding only a little ETH for gas. It is deliberately
# low-value: claimBatch is permissionless and moves USDC *into* the pool, with no
# path to move anything out, so this key controls nothing but its own gas.
# It is NOT the pool owner key and must never be — the owner can pause joins,
# which is a power this wallet has no business holding.
#
# Unset = cranking is off. The cron then alerts (and returns non-2xx) whenever
# settled winnings are actually waiting, so it fails loudly rather than silently.
POOL_KEEPER_PRIVATE_KEY=

# Where operational alerts go — a plain JSON POST. The body carries both `content`
# (Discord) and `text` (Slack), so either webhook URL works as-is. Unset is fine:
# alerts still reach the logs as `[pool:ALERT]` and still mark the cron run failed,
# which triggers Vercel's own cron-failure notification.
POOL_ALERT_WEBHOOK_URL=
