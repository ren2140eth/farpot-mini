# Copy to .env.local and fill in. None of these are committed (.env* is gitignored).

# Public base URL of your deployment (used by the manifest + embeds).
# Local dev can leave this unset (falls back to http://localhost:3000).
NEXT_PUBLIC_URL=https://your-app.vercel.app

# OnchainKit / Coinbase Developer Platform API key — https://portal.cdp.coinbase.com
# Used for wallet connection + RPC. Recommended (the app falls back to public RPCs).
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# Neynar API key — https://neynar.com — powers the gift-a-ticket recipient lookup
# (@username -> verified Base address). Only the FREE by_username/bulk endpoints
# are used. Without it, gift-by-handle search is disabled; self-buy still works.
NEYNAR_API_KEY=

# --- Optional: post-draw "check your results" notifications ---
# Upstash Redis (REST) stores Farcaster notification tokens. If unset, the
# notification + webhook routes no-op cleanly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# to authorize the post-draw notify job. Leave unset to disable the auth gate.
CRON_SECRET=
