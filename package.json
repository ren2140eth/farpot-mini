{
  "name": "farpot-mini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "forge:build": "scripts/forge.sh build",
    "forge:test": "scripts/forge.sh test",
    "forge:fork": "FORK=1 scripts/forge.sh test --match-path \"test/*.fork.t.sol\" --fork-url $BASE_RPC_URL",
    "forge:gas": "scripts/forge.sh test --gas-report",
    "prepare": "git config core.hooksPath scripts/hooks || true"
  },
  "dependencies": {
    "@coinbase/onchainkit": "^1.1.2",
    "@farcaster/miniapp-node": "^0.2.0",
    "@farcaster/miniapp-sdk": "^0.2.3",
    "@tanstack/react-query": "^5.101.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
