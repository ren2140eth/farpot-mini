# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# this repo uses npm (package-lock.json) — keep stray pnpm lockfiles out
pnpm-lock.yaml
pnpm-workspace.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# internal / non-published material — public repo is prod code only.
# Keep briefs, process notes, design mockups, agent instructions, personal
# info, and one-off proof/scratch scripts OUT of the open-source repo.
AGENTS.md
CLAUDE.md
/branding/
/docs/briefs/
*-proof.mjs
*.internal.*
NOTES.md
TODO.md

# typescript
*.tsbuildinfo
next-env.d.ts
