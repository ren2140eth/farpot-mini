# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# this repo uses npm (package-lock.json) — keep stray pnpm lockfiles out
pnpm-lock.yaml
pnpm-workspace.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# internal / non-published material — public repo is prod code only.
# Keep briefs, process notes, design mockups, agent instructions, personal
# info, and one-off proof/scratch scripts OUT of the open-source repo.
AGENTS.md
CLAUDE.md
/branding/
/docs/briefs/
*-proof.mjs
*-proof.ts
*.internal.*
/specs/
NOTES.md
TODO.md
# Playwright/browser-automation scratch: screenshots, console logs and page snapshots dropped
# by the MCP browser tools during UI verification. Working material, never prod code — and it
# has been sitting untracked in `git status` where a careless `git add` could sweep it in.
/.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# foundry (contracts/) — build artefacts only; src/, test/ and lib/ submodules are tracked
/contracts/out/
/contracts/cache/
/contracts/broadcast/
# Belt and braces: forge resolves a few paths against the working directory rather than
# --root, so a stray `cache/` can appear at the repo root. scripts/forge.sh now cds into
# contracts/ to prevent it; this rule means a direct `forge` invocation cannot leak either.
/cache/
/out/
/broadcast/

